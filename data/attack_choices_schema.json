{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-killer.local/schemas/attack_choices_v1.json",
  "type": "object",
  "required": ["catalog_version", "choices_per_round", "choices"],
  "properties": {
    "catalog_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "choices_per_round": {"type": "integer", "minimum": 1, "maximum": 20},
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/choice"}
    }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "required": [
        "id", "startup_slug", "round_number", "title", "short_description",
        "result_headline", "attack_type", "severity", "scale", "feasibility",
        "target_stream_ids", "weakness_match", "evidence_fact_ids", "duration",
        "stack_group", "scene_type", "narrative"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "startup_slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "round_number": {"type": "integer", "minimum": 1, "maximum": 3},
        "title": {"type": "string", "minLength": 2, "maxLength": 90},
        "short_description": {"type": "string", "minLength": 8, "maxLength": 220},
        "result_headline": {"type": "string", "minLength": 2, "maxLength": 120},
        "attack_type": {
          "enum": ["competition", "product", "demand", "supply", "technology", "reputation", "cost", "finance", "absurd"]
        },
        "severity": {"enum": ["weak", "medium", "strong", "critical"]},
        "scale": {"enum": ["local", "regional", "company_wide"]},
        "feasibility": {"enum": ["unsupported", "plausible", "established_in_state"]},
        "target_stream_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "weakness_id": {"type": ["string", "null"]},
        "weakness_match": {"enum": ["indirect", "normal", "exact"]},
        "evidence_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "duration": {"enum": ["temporary", "persistent", "structural"]},
        "stack_group": {"type": "string", "minLength": 1, "maxLength": 80},
        "scene_type": {"enum": ["demand", "reputation", "competition", "supply", "technology", "finance", "pivot", "absurd"]},
        "narrative": {
          "type": "object",
          "required": ["attack", "company_response", "result"],
          "properties": {
            "attack": {"type": "string", "minLength": 8, "maxLength": 260},
            "company_response": {"type": "string", "minLength": 8, "maxLength": 260},
            "result": {"type": "string", "minLength": 8, "maxLength": 320}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
